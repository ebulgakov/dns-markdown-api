{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // --- Переопределяем опции для сборки под Node.js ---
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2020", // Устанавливаем совместимую с Node.js версию
    "outDir": "./dist",
    "rootDir": "./src",

    // --- Отключаем опции, специфичные для Bun/разработки ---
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": false, // Важно для генерации реального JS-кода
    "moduleDetection": "auto",

    // --- Сохраняем полезные опции ---
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}

{
  "name": "dns-markdown-api",
  "module": "src/index.ts",
  "type": "module",
  "dependencies": {
    "@clerk/backend": "^2.29.7",
    "@clerk/express": "^1.7.67",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.69.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.211.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.211.0",
    "@opentelemetry/resources": "^2.5.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@sentry/node": "^10.38.0",
    "@upstash/redis": "^1.36.1",
    "@upstash/vector": "^1.2.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "mongodb": "^7.1.0",
    "mongoose": "^9.1.5",
    "morgan": "^1.10.1",
    "openai": "^6.21.0",
    "svix": "^1.84.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.1",
    "typescript-eslint": "^8.54.0"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "lint:fix": "bunx eslint --fix .",
    "lint": "bunx eslint",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "type-check": "bunx tsc --noEmit",
    "build": "bun build src/index.ts --outfile dist/index.js --target node --bundle --external mongoose --external @sentry/node --external @opentelemetry/* --external zod",
    "start": "node dist/index.js",
    "prepare": "husky"
  }
}
